{
	"name": "getkirby/coding-standards",
	"description": "The Kirby code style for PHP CS Fixer",
	"license": "MIT",
	"type": "library",
	"keywords": ["kirby", "code style", "php-cs-fixer"],
	"homepage": "https://getkirby.com",
	"require": {
		"php": ">=8.3.0",
		"friendsofphp/php-cs-fixer": "3.95.3"
	},
	"autoload": {
		"psr-4": {
			"Kirby\\CodingStandards\\": "src/"
		}
	},
	"bin": ["bin/kirby-cs"],
	"config": {
		"sort-packages": true
	}
}
