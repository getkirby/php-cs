{
	"name": "getkirby/php-cs",
	"description": "The Kirby PHP code style",
	"license": "MIT",
	"type": "library",
	"keywords": ["kirby", "code style", "php-cs-fixer"],
	"homepage": "https://getkirby.com",
	"require": {
		"php": ">=8.3.0",
		"friendsofphp/php-cs-fixer": "3.95.3"
	},
	"autoload": {
		"psr-4": {
			"Kirby\\PhpCs\\": "src/"
		}
	},
	"bin": ["bin/kirby-cs"],
	"config": {
		"sort-packages": true
	},
	"require-dev": {
		"phpunit/phpunit": "^12.0"
	}
}
